# Copy this file to ".env" (same folder as pom.xml) and fill in your values.
# ".env" is git-ignored. NEVER commit real passwords or secrets.

DB_URL=jdbc:mysql://localhost:3306/careerpilot_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=careerpilot
DB_PASSWORD=change-me

# At least 32 random characters. Generate one with:  openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=1440

# Extra allowed frontend origins (optional). Defaults already allow localhost and *.app.github.dev
# CORS_ALLOWED_ORIGINS=http://localhost:*,https://*.app.github.dev

# Optional e-mail (leave MAIL_ENABLED=false to skip)
MAIL_ENABLED=false
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_FROM=
